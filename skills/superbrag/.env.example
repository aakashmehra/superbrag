# Copy to .env (setup.sh creates it and fills the two paths for you).
# Free local voice + word timings (written by setup.sh):
KOKORO_PYTHON=
WHISPER_PYTHON=
# Optional premium voices (about 5 cents per video). If a key is set, it's used instead of Kokoro:
MINIMAX_API_KEY=
ELEVENLABS_API_KEY=
# Only older MiniMax accounts:
# MINIMAX_GROUP_ID=
# Only mainland-China MiniMax accounts:
# MINIMAX_HOST=api.minimaxi.com
